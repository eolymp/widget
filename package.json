{
  "name": "@eolymp/widget",
  "version": "0.0.0",
  "description": "Build widget (Bebras-style) problems for Eolymp: the host protocol, input helpers, base styles and a dev/pack CLI.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/eolymp/widget#readme",
  "keywords": [
    "eolymp",
    "bebras",
    "widget",
    "interactive",
    "task"
  ],
  "sideEffects": [
    "./dist/style.css",
    "./dist/widget-sdk.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./style.css": "./dist/style.css",
    "./widget-sdk.js": "./dist/widget-sdk.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "eolymp-widget": "cli/index.js"
  },
  "files": [
    "dist",
    "cli",
    "template",
    "AGENTS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsup --silent && cp src/style.css dist/style.css && mkdir -p examples/lib && cp dist/widget-sdk.js examples/lib/ && cp dist/style.css examples/lib/widget-sdk.css",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eolymp/widget.git"
  }
}
